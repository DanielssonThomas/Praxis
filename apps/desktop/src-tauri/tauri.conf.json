{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxis",
  "version": "0.1.0",
  "identifier": "app.praxis.desktop",
  "build": {
    "frontendDist": "../dist/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Praxis",
        "width": 1120,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"]
  }
}
