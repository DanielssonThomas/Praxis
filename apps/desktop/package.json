    "@angular/router": "21.2.26",
    "@tauri-apps/api": "2.12.5",
    "chart.js": "4.6.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "21.2.31",
    "@angular/cli": "21.2.31",
    "@angular/compiler-cli": "21.2.26",
    "@tauri-apps/cli": "2.12.6"
